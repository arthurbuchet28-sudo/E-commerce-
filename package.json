{
  "name": "pub-motion-design",
  "version": "1.0.0",
  "private": true,
  "description": "Publicité motion design de 15 s générée avec Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Pub out/pub.mp4",
    "render:site": "remotion render PubSite out/pub-site.mp4",
    "still": "remotion still Pub out/still.png",
    "typecheck": "tsc --noEmit",
    "render:tiktok": "remotion render PubSiteVertical out/pub-site-tiktok.mp4",
    "render:mockup": "remotion render PubMockup out/pub-mockup.mp4",
    "music": "python3 scripts/make-music.py public/mockup-music.wav",
    "render:boost": "remotion render PubBoost out/pub-boost.mp4",
    "music:boost": "python3 scripts/make-music-boost.py public/boost-music.wav",
    "render:gaucheup": "remotion render GaucheUp out/gaucheup.mp4",
    "music:gaucheup": "python3 scripts/make-music-gaucheup.py public/gaucheup/gaucheup-music.wav"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/sour-gummy": "5.2.8",
    "@remotion/cli": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
