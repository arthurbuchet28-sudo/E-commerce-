# ---------------------------------------------------------------------------
# Première Vente — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Validated at startup by src/lib/env.ts: the server refuses to start if invalid.
# Every variable is optional locally: mocks are used when a service is missing.
# ---------------------------------------------------------------------------

# local | preview | production. In production, mocks are refused and secrets required.
APP_ENV=local

# Public URL of the site (canonical URLs, sitemap, e-mails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (EU region: Frankfurt) --------------------------------------
# Local: `pnpm exec supabase start`, then copy API_URL, PUBLISHABLE_KEY and SECRET_KEY
# printed by `pnpm exec supabase status`. Publishable/secret keys and the legacy
# anon/service_role keys both work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (use test keys outside production) ----------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally.
# Without STRIPE_SECRET_KEY (local only), payments are simulated on /paiement-simule and the
# simulated webhook is signed with a built-in local secret.
STRIPE_WEBHOOK_SECRET=

# --- E-mails & newsletter --------------------------------------------------
# console = e-mails printed in the terminal; mailpit = e-mails shown in the local Mailpit
# (http://127.0.0.1:54324, started by `supabase start`); brevo = real sending.
EMAIL_PROVIDER=console
MAILPIT_URL=http://127.0.0.1:54324
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
EMAIL_FROM=bonjour@premiere-vente.fr
# Inbox notified of contact form messages (optional: messages are listed in /admin/messages).
CONTACT_EMAIL=

# --- Scheduled jobs (newsletter welcome sequence, purges) -----------------
# Random string (e.g. `openssl rand -hex 32`); required outside local development.
CRON_SECRET=

# --- Course videos ---------------------------------------------------------
# mock = placeholder player (local); bunny = Bunny Stream with signed URLs.
VIDEO_PROVIDER=mock
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=

# --- Audience measurement (Matomo Cloud EU, consent-exempt setup) ----------
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# --- Error monitoring (Sentry, EU region) ----------------------------------
# DSN of a Sentry organisation created in the EU data region: its host must end in
# .de.sentry.io (the server refuses to start otherwise). Required in production.
# Server side only: browser errors are relayed by /api/erreurs, personal data scrubbed.
SENTRY_DSN=

# --- Backups (read by scripts/backup-db.sh and the « Sauvegarde » workflow, not by the site)
# See docs/sauvegardes.md. Never put the age PRIVATE key here.
# SUPABASE_DB_URL=postgresql://…
# BACKUP_AGE_RECIPIENT=age1…
# BACKUP_INCLUDE_FILES=1
