---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-display text-7xl text-gold">404</p>
    <h1 class="mt-4 text-3xl">Cette gemme reste introuvable</h1>
    <p class="mt-4 text-muted">La page demandée n'existe pas ou a été déplacée.</p>
    <a href="/catalogue" class="btn btn-gold mt-8">Retour au catalogue</a>
  </div>
</BaseLayout>
