---
/**
 * Carte de gemme (catalogue, accueil, gemmes similaires).
 * Les attributs data-* servent au filtrage instantané du catalogue.
 */
import GemImage from "./GemImage.astro";
import { type Gem, CATEGORY_LABELS, COLORS, formatHardness } from "../lib/gems";

interface Props {
  gem: Gem;
  priority?: boolean;
  headingLevel?: "h2" | "h3";
}
const { gem, priority = false, headingLevel: H = "h3" } = Astro.props;
const search = [gem.name, gem.nameEn, gem.family, ...gem.colors, ...gem.deposits].join(" ");
---

<li
  class="gem-card group relative overflow-hidden rounded-2xl border border-line bg-surface"
  data-gem
  data-name={gem.name}
  data-search={search}
  data-category={gem.category}
  data-colors={gem.colors.join(" ")}
  data-hmin={gem.hardness.min}
  data-hmax={gem.hardness.max}
  data-months={gem.birthMonths.join(" ")}
>
  <div class="aspect-square overflow-hidden bg-surface-2">
    <GemImage gem={gem} priority={priority} class="h-full w-full object-cover" />
  </div>
  <div class="p-4">
    <p class="text-[0.7rem] uppercase tracking-[0.18em] text-gold">{CATEGORY_LABELS[gem.category]}</p>
    <H class="mt-1 text-xl">
      <a href={`/gemmes/${gem.slug}`} class="after:absolute after:inset-0 focus:outline-none">
        {gem.name}
      </a>
    </H>
    <p class="text-xs text-muted">{gem.nameEn}</p>
    <div class="mt-3 flex items-center justify-between gap-2">
      <ul class="flex flex-wrap gap-1" aria-label="Couleurs">
        {
          gem.colors.slice(0, 6).map((c) => (
            <li>
              <span class="swatch" style={`background:${COLORS[c].swatch}`} title={COLORS[c].label} />
              <span class="sr-only">{COLORS[c].label}</span>
            </li>
          ))
        }
      </ul>
      <span class="text-xs text-muted" title="Dureté sur l'échelle de Mohs">Mohs {formatHardness(gem)}</span>
    </div>
  </div>
</li>
